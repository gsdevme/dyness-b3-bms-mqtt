# Configuration for dyness-b3-bms-mqtt, read by systemd as EnvironmentFile=.
#
# Installed as /etc/default/dyness-b3-bms-mqtt, mode 0600, owner root, because it may hold
# MQTT_PASSWORD. Every variable is listed commented out with its default; uncomment a line
# and change the value to override it. An empty value counts as unset and takes the default.
# Changes take effect on the next restart. Check them with `make check-config`.
#
# Write plain KEY=value lines. The root helpers (can-up, recover) read the CAN_* lines
# without executing the file, stripping one layer of matching single or double quotes.
# Names, defaults and valid ranges: docs/specs/08-configuration.md.

# ---- CAN ----

# python-can interface: socketcan, gs_usb, slcan or virtual
#CAN_INTERFACE=socketcan
# socketcan/virtual: interface name; slcan: serial device path; gs_usb: adapter index
#CAN_CHANNEL=can0
# CAN bitrate in bit/s (10000..1000000), set by can-up and by non-socketcan interfaces
#CAN_BITRATE=500000
# Kernel automatic bus-off restart delay in ms (0..60000); 0 disables it
#CAN_RESTART_MS=100
# true: never transmit and send no polls; cell values then appear only if something else polls
#CAN_LISTEN_ONLY=false
# USB vendor:product (hhhh:hhhh) the USB reset uses to find the adapter when CAN_CHANNEL is gone
#CAN_USB_ID=1d50:606f
# Number of modules (1..4); modules 1..MODULE_COUNT are polled and published
#MODULE_COUNT=3
# Optional Home Assistant device names per module, e.g. 1:Top,2:Middle,3:Bottom
#MODULE_NAMES=

# ---- Polling and freshness ----

# Seconds between the initial polls of consecutive modules (0.05..5)
#POLL_STAGGER_S=0.3
# Seconds between re-polls of a module whose cell stream is stale (1..60)
#POLL_RETRY_S=5
# Re-polls at POLL_RETRY_S before falling back to POLL_BACKOFF_S (0..20)
#POLL_MAX_RETRIES=3
# Re-poll interval in seconds once retries are exhausted (at least POLL_RETRY_S)
#POLL_BACKOFF_S=60
# Seconds after the bus opens before module staleness is judged (5..120)
#START_GRACE_S=20
# A module's cell stream older than this many seconds is stale (2..300)
#CELL_STALE_S=10
# A module whose broadcast frames are older than this many seconds is SILENT (2..300)
#MODULE_STALE_S=10
# No frame at all for this many seconds means the bus or adapter is STALE (>= MODULE_STALE_S)
#BUS_SILENCE_S=15

# ---- Recovery ----

# In-process bus reopen attempts before exiting for external recovery (0..10)
#BUS_REOPEN_ATTEMPTS=2
# Seconds of continuous HEALTHY after which the escalation counter resets (>= 60)
#RECOVERY_RESET_S=300
# Escalation count at or above which the service enters DEAD mode instead of exiting (1..20)
#DEAD_AFTER=3
# Seconds between bus reopen attempts while DEAD (10..3600)
#DEAD_RETRY_S=60
# Seconds between USB resets (exit 76) while DEAD (>= DEAD_RETRY_S)
#DEAD_USB_RESET_S=900
# Error frames within ERROR_WINDOW_S that suspend polling for the process lifetime (1..1000)
#ERROR_SUSPEND_COUNT=10
# Sliding window in seconds for ERROR_SUSPEND_COUNT (5..3600)
#ERROR_WINDOW_S=60

# ---- MQTT ----

# Broker host name or address
#MQTT_HOST=localhost
# Broker port (1..65535)
#MQTT_PORT=1883
# Optional broker user name
#MQTT_USERNAME=
# Optional broker password (needs MQTT_USERNAME); redacted in logs
#MQTT_PASSWORD=
# Client id, 1..64 chars [A-Za-z0-9_-]; empty means dyness-b3-bms-mqtt-<hostname>
#MQTT_CLIENT_ID=
# true: connect to the broker with TLS
#MQTT_TLS=false
# Optional CA certificate file for TLS; must exist and be readable at start-up
#MQTT_CA_FILE=
# MQTT keepalive in seconds (5..300)
#MQTT_KEEPALIVE_S=30
# Topic prefix for state and availability, 1..64 chars [A-Za-z0-9_/-], no + or #
#MQTT_BASE_TOPIC=dyness_b3
# Seconds between periodic state publishes (1..300)
#PUBLISH_INTERVAL_S=10

# ---- Home Assistant ----

# true: publish Home Assistant discovery; false: publish state only
#HA_DISCOVERY=true
# Home Assistant discovery topic prefix
#HA_DISCOVERY_PREFIX=homeassistant
# Prefix of every unique_id, 1..32 chars [a-z0-9_]; changing it creates new entities in HA
#HA_NODE_ID=dyness_b3
# Human name prefix for the Home Assistant devices (1..64 chars)
#HA_DEVICE_NAME=Dyness B3
# Seconds before HA marks values unavailable; 0 means 3 x PUBLISH_INTERVAL_S + 5
#EXPIRE_AFTER_S=0

# ---- Alerts ----

# Per-module max-min cell voltage in mV above which the spread alert is on (1..1000)
#ALERT_CELL_SPREAD_MV=50
# Any cell below this many mV turns the low-cell alert on (2000..3600)
#ALERT_CELL_LOW_MV=3000
# Module current imbalance percentage that turns the imbalance alert on (1..100)
#ALERT_CURRENT_IMBALANCE_PCT=20
# Imbalance is only evaluated when the absolute stack current is at least this many A (0..200)
#ALERT_IMBALANCE_MIN_CURRENT_A=10
# Seconds a condition must hold before an alert changes state; 0 is immediate (0..600)
#ALERT_DEBOUNCE_S=30
# Percentage of the threshold a value must recover by before a "greater than" alert clears (0..50)
#ALERT_HYSTERESIS_PCT=10
# mV above ALERT_CELL_LOW_MV the lowest cell must reach before the low-cell alert clears (0..500)
#ALERT_CELL_LOW_HYSTERESIS_MV=50

# ---- Logging ----

# Log level: DEBUG, INFO, WARNING or ERROR
#LOG_LEVEL=INFO

# ---- Local history ----

# true: keep the local CSV and events history under $STATE_DIRECTORY/logs
#LOCAL_LOG=true
# Seconds between history rows (1..300)
#LOCAL_LOG_INTERVAL_S=10
# Daily files older than this many days are deleted (1..3650)
#LOCAL_LOG_RETENTION_DAYS=90
# Daily files older than this many days are gzipped; today's never is (0..LOCAL_LOG_RETENTION_DAYS)
#LOCAL_LOG_COMPRESS_AFTER_DAYS=1
